{
  "expo": {
    "name": "Northstall",
    "slug": "northstall",
    "scheme": "northstall",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.northstall.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.northstall.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      ["@stripe/stripe-react-native", { "merchantIdentifier": "merchant.com.northstall.app" }]
    ],
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
